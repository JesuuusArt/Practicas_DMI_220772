  "states": [
    { "id": "idle", "type": "start", "label": "Chat en reposo", "sublabel": "campo vacio", "lane": "main", "col": 0, "step": "01", "tag": "espera" },
    { "id": "saved", "type": "active", "label": "Mensaje en la lista", "sublabel": "Message(me, _now())", "lane": "main", "col": 1, "step": "02", "tag": "estado" },
    { "id": "decision", "type": "decision", "label": "Termina en '?'", "sublabel": "unica regla", "lane": "main", "col": 2, "step": "03", "tag": "regla" },
    { "id": "fetching", "type": "active", "label": "Peticion HTTP", "sublabel": "GET /api?force=", "lane": "main", "col": 3, "step": "04", "tag": "red" },
    { "id": "answer", "type": "active", "label": "Respuesta construida", "sublabel": "toMessageEntity()", "lane": "main", "col": 4, "step": "05", "tag": "modelo" },
    { "id": "silent", "type": "waiting", "label": "Sin respuesta", "sublabel": "no era pregunta", "lane": "waiting", "col": 0, "tag": "quieto" },
    { "id": "failed", "type": "failure", "label": "Error controlado", "sublabel": "Dio o FormatException", "lane": "exceptions", "col": 0, "yOffset": 78, "width": 168, "tag": "traducido" },
    { "id": "done", "type": "success", "label": "Respuesta pintada", "sublabel": "Si / No / Tal vez", "lane": "terminal", "col": 2, "step": "06", "tag": "listo" }
