    { "id": "no-branch", "from": "decision", "to": "silent", "variant": "default", "label": "no", "labelAt": [402, 233], "route": "drop", "note": "Queda guardado, no se pide nada." },
    { "id": "build", "from": "fetching", "to": "answer", "variant": "emphasis", "note": "pickAnswer() ya decidio 40/40/20 y la cola evita solaparse." },
    { "id": "http-ok", "from": "answer", "to": "done", "variant": "emphasis", "label": "200 + gif", "labelAt": [710, 330], "route": "straight", "fromSide": "bottom", "toSide": "top" },
    { "id": "http-fail", "from": "fetching", "to": "failed", "variant": "security", "label": "DioException", "labelAt": [556, 265], "fromSide": "bottom", "toSide": "top", "via": [[556, 188], [556, 346], [402, 346]] },
    { "id": "error-visible", "from": "failed", "to": "done", "variant": "default", "label": "se ve igual", "labelAt": [526, 479], "fromSide": "bottom", "toSide": "left", "via": [[402, 414], [402, 479]] }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Una sola regla",
      "items": [
        "Solo el texto que termina en '?' pide respuesta",
        "trim() se aplica antes de comparar y de guardar"
      ]
    },
    {
      "dot": "amber",
      "title": "El error tambien se ve",
      "items": [
        "Dio y FormatException se traducen a YesNoException",
