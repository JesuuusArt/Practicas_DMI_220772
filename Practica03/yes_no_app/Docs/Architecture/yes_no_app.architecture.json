    "cards":  [
                  {
                      "dot":  "emerald",
                      "title":  "Recorrido de una pregunta",
                      "items":  [
                                    "MessageFieldBox dispara sendMessage() y solo pide respuesta si el texto termina en \u0027?\u0027",
                                    "GetYesNoAnswer sortea 40/40/20 y usa \u0027?force=\u0027 para que el texto y el GIF coincidan",
                                    "YesNoModel traduce yes/no/maybe a Si / No / Tal vez y devuelve una entidad Message"
                                ]
                  },
                  {
                      "dot":  "cyan",
                      "title":  "Capas del proyecto",
                      "items":  [
                                    "Presentacion: main.dart, ChatScreen, ChatProvider y los widgets de burbuja y campo",
                                    "Dominio: Message con FromWho y sentAt, sin depender de Flutter ni de la API",
                                    "Infraestructura: YesNoModel es el unico que conoce el JSON de yesno.wtf"
                                ]
                  },
                  {
                      "dot":  "amber",
                      "title":  "Estado y reloj",
                      "items":  [
                                    "ChatProvider es el unico ChangeNotifier y concentra el messageList del chat",
                                    "El reloj es inyectable (now: () =\u003e DateTime) para poder fijar la hora en los tests",
                                    "formatTimeOfDay aplica el formato de WhatsApp: 9:37 a.m. y 2:05 p.m."
                                ]
                  }
              ]
}