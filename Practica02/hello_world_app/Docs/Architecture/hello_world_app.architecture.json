  "cards": [
    {
      "dot": "cyan",
      "title": "Punto de entrada",
      "items": [
        "main() unicamente llama runApp(MyApp)",
        "MyApp es un StatelessWidget: no guarda estado",
        "home apunta a CounterFunctionsScreen"
      ]
    },
    {
      "dot": "emerald",
      "title": "Estado local",
      "items": [
        "Es el unico StatefulWidget con estado de la app",
        "clickCounter vive en el State, no en el widget",
        "Los tres botones solo cambian un int"
      ]
    },
    {
      "dot": "violet",
      "title": "Tema y tipografia",
      "items": [
        "colorSchemeSeed magenta ARGB(255,208,33,243)",
        "displayLarge con GoogleFonts.rockSalt a 160 pt",
        "La pantalla vuelve a llamar a GoogleFonts.rockSalt"
      ]
    },
    {
      "dot": "amber",
      "title": "Colores del contador",
      "items": [
        "_getCounterColor: 0 es azul, mayor que 0 verde, menor rojo",
        "Las constantes viven en main.dart, no en la pantalla",
        "Click usa plural solo cuando el valor supera 1"
      ]
    },
    {
      "dot": "rose",
      "title": "Hallazgos del analisis",
      "items": [
        "counter_screen.dart nunca se importa: es codigo muerto",
        "cupertino_icons esta declarado en pubspec sin usarse",
        "El smoke test pulsa Icons.add y la app usa Icons.plus_one"
      ]
    }
  ]
